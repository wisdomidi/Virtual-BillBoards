# ==============================================================================
# Virtual Billboard Platform - Environment Configuration Template
# All API keys & secrets must be placed in .env (never committed to git)
# ==============================================================================

# Google Gemini API
GEMINI_API_KEY=

# Application URL
APP_URL=http://localhost:3000

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=livebillboards-production.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=livebillboards-production
VITE_FIREBASE_STORAGE_BUCKET=livebillboards-production.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Server-Side Firebase Overrides (optional, defaults to above)
FIREBASE_PROJECT_ID=livebillboards-production
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=livebillboards-production.firebaseapp.com
FIREBASE_STORAGE_BUCKET=livebillboards-production.firebasestorage.app
FIREBASE_DATABASE_ID=(default)

# Stripe Payment & Checkout Configuration
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_M2M_SECRET_KEY=
