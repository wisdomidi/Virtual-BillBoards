rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile and wallet
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Transactions: owner-only read, server-only write (enforced via Admin SDK / server.ts)
      match /transactions/{txnId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only server writes transactions
      }
    }

    // Campaigns: authenticated users can create; anyone can read active ads for display
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Slot burns: server-only writes, no direct client access
    match /slot_burns/{burnId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server writes slot burns
    }

    // Deny all other document access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
