rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
      
      match /transactions/{txnId} {
        allow read, write: if true;
      }
    }
    match /campaigns/{campaignId} {
      allow read, write: if true;
    }
    match /slot_burns/{burnId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
